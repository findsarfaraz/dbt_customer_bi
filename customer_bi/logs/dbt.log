    create or replace temporary view `gold_item__dbt_tmp` as
      
    
    with snapshot_query as (

        select * from `dev`.`customer_bi_gold`.`items_scd2`

    ),

    snapshotted_data as (

        select *, 
    
        id as dbt_unique_key
    

        from `dev`.`customer_bi_gold`.`gold_item`
        where
            
                
                

                
                ( (dbt_valid_to = to_date('9999-12-31'))
 or dbt_valid_to is null )
            

    ),

    insertions_source_data as (

        select *, 
    
        id as dbt_unique_key
    
,
            create_datetime as dbt_updated_at,
            create_datetime as dbt_valid_from,
            
  
  coalesce(nullif(create_datetime, create_datetime), to_date('9999-12-31'))
  as dbt_valid_to
,
            md5(coalesce(cast(id as string ), '')
         || '|' || coalesce(cast(create_datetime as string ), '')
        ) as dbt_scd_id

        from snapshot_query
    ),

    updates_source_data as (

        select *, 
    
        id as dbt_unique_key
    
,
            create_datetime as dbt_updated_at,
            create_datetime as dbt_valid_from,
            create_datetime as dbt_valid_to

        from snapshot_query
    ),

    insertions as (

        select
            'insert' as dbt_change_type,
            source_data.*

        from insertions_source_data as source_data
        left outer join snapshotted_data
            on 
    
        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key
    

            where 
    
        snapshotted_data.dbt_unique_key is null
    

            or (
    
        snapshotted_data.dbt_unique_key is not null
    
 and (
                (snapshotted_data.dbt_valid_from < source_data.create_datetime)
            )

        )

    ),

    updates as (

        select
            'update' as dbt_change_type,
            source_data.*,
            snapshotted_data.dbt_scd_id

        from updates_source_data as source_data
        join snapshotted_data
            on 
    
        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key
    

        where (
            (snapshotted_data.dbt_valid_from < source_data.create_datetime)
        )
    )

    select * from insertions
    union all
    select * from updates

  
    
