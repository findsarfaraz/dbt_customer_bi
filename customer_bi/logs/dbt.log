 SUM(total_gross_amount) as total_gross_amount, 
 SUM(total_quantity) as total_quantity FROM SALES  

JOIN CUSTOMER 
on SALES.customer_sk = CUSTOMER.customer_sk
group by CUSTOMER.gender
  
